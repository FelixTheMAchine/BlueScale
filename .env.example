# Copie para .env. NUNCA publique este arquivo com credenciais reais.
DATABASE_URL="postgresql://bluescale:bluescale_local@localhost:5432/bluescale?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_COM_NO_MINIMO_32_CARACTERES"
# O seed recusa senhas fracas e credenciais ausentes.
ADMIN_EMAIL="admin@bluescale.local"
ADMIN_PASSWORD="INSIRA_SENHA_FORTE_AQUI_12+"
# Opcional: habilita três contas fictícias (GP, coordenador, membro) em desenvolvimento.
DEMO_PASSWORD=""
# HTTPS obrigatório fora do localhost.
NODE_ENV="development"
# Opcional: otimizador MILP executado em serviço privado.
# SOLVER_SERVICE_URL="http://solver:8090"
# SOLVER_SERVICE_TOKEN="GERAR_SEGREDO_INDEPENDENTE"
# Em produção, não execute seed fictício; banco começa vazio.
# ALLOW_DEMO_SEED="" # só funciona com YES_I_UNDERSTAND
# Android online: forneça o endereço HTTPS público ao compilar.
# BLUESCALE_URL="https://seu-app.exemplo.com"
